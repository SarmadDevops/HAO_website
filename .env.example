# Copy this file to .env and fill in the values you need.
# Everything prefixed with VITE_ is bundled into the public website,
# so never put passwords, API secrets or payment credentials here.

# Public URL of the live site, without a trailing slash.
# Used for canonical links, Open Graph tags and structured data.
VITE_SITE_URL=

# Form endpoints. Each form posts multipart FormData to its URL.
# Works with a Google Apps Script web app, Formspree, Getform or a custom API.
# Leave empty to disable online submission; the form will then show
# WhatsApp/email alternatives instead of pretending the message was sent.
VITE_VOLUNTEER_FORM_ENDPOINT=
VITE_CONTACT_FORM_ENDPOINT=
VITE_NEWSLETTER_FORM_ENDPOINT=
